      "tags": ["consonant"],
      "difficulty": 1,
      "distractors": ["u83-i04"],
      "note": "You met గ already inside ఈగ (fly). Now it has a name."
    },
    {
      "id": "u83-i04",
      "te": "ఘ",
      "audioTe": "ఘ. ఘనం.",
      "gloss": "gha — as in 'ghanam' (grand, solid)",
      "words": [{ "te": "ఘ", "gloss": "gha — గ with a puff of breath" }],
      "tags": ["consonant"],
      "difficulty": 2,
      "distractors": ["u83-i03", "u83-i08"],
      "note": "ఘ and ఝ are lookalike loops — ఘ belongs to the క row, ఝ to the చ row."
    },
    {
      "id": "u83-i05",
      "te": "చ",
      "audioTe": "చ. చాయ్.",
      "gloss": "cha — as in 'chaay' (tea)",
