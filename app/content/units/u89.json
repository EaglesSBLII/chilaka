  "cefr": "A0",
  "register": "standard",
  "description": "Conjuncts: a small consonant tucked below doubles or clusters the sound — అమ్మ, పిల్లి, స్కూలు.",
  "items": [
    {
      "id": "u89-i01",
      "te": "క క్క",
      "audioTe": "క. అక్క.",
      "gloss": "ka vs kka — spot the vattu tucked below",
      "words": [
        { "te": "క", "gloss": "ka — single" },
        { "te": "క్క", "gloss": "kka — doubled: hold the k a beat longer" }
      ],
      "tags": ["concept"],
      "difficulty": 2,
      "note": "A వత్తు is a mini consonant hanging under its partner. It kills the first letter's vowel and doubles the sound: క్క, ల్ల, త్త."
    },
    {
      "id": "u89-i02",
      "te": "అక్క",
      "gloss": "akka — elder sister",
      "words": [
        { "te": "అ", "gloss": "a" },
        { "te": "క్క", "gloss": "kka — doubled క" }
      ],
      "tags": ["word"],
      "difficulty": 2,
      "distractors": ["u89-i06", "u81-i07"],
      "note": "అక్క vs అత్త (aunt) — both are అ + a doubled letter. Family words love vattulu: అమ్మ, అక్క, అత్త, నాన్న."
    },
    {
      "id": "u89-i03",
      "te": "నాన్న",
      "gloss": "naanna — dad",
      "words": [
        { "te": "నా", "gloss": "naa" },
        { "te": "న్న", "gloss": "nna — doubled న" }
      ],
      "tags": ["word"],
      "difficulty": 2,
      "distractors": ["u89-i04", "u89-i02"]
    },
    {
      "id": "u89-i04",
      "te": "అన్నం",
      "gloss": "annam — rice, food",
      "words": [
        { "te": "అ", "gloss": "a" },
        { "te": "న్నం", "gloss": "nnam — doubled న plus the sunna" }
      ],
      "tags": ["word"],
      "difficulty": 2,
      "distractors": ["u89-i03", "u89-i02"],
      "note": "అన్నం తిన్నావా? (have you eaten?) — the most Telugu question there is, and now you can read its heart."
    },
    {
      "id": "u89-i05",
      "te": "పిల్లి",
      "gloss": "pilli — cat",
      "words": [
