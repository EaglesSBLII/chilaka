    {
      "id": "u04-i15",
      "te": "మీది ఏ ఊరు?",
      "gloss": "Which town are you from?",
      "words": [
        { "te": "మీది", "gloss": "yours" },
        { "te": "ఏ", "gloss": "which" },
        { "te": "ఊరు", "gloss": "town / village" }
      ],
      "tags": ["questions", "smalltalk"],
      "difficulty": 2,
      "note": "THE Telugu icebreaker. మీది (miidi) = 'yours': literally 'yours is which town?' Answer with మాది (maadi) = 'ours'."
