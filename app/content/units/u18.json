  "description": "Share what you think, agree and disagree gracefully, and shrug like a native.",
  "items": [
    {
      "id": "u18-i01",
      "te": "మీరు ఏమంటారు?",
      "gloss": "What do you say? (what's your take?)",
      "words": [
        { "te": "మీరు", "gloss": "you (polite)" },
        { "te": "ఏమంటారు", "gloss": "what do (you) say?" }
      ],
      "tags": ["opinions", "questions"],
      "difficulty": 3,
      "note": "Literally 'what will you say?' — the everyday way to ask for an opinion. With friends: నువ్వేమంటావ్ (nuvveemantaav)?",
      "distractors": ["u18-i13", "u18-i10"]
    },
    {
      "id": "u18-i02",
      "te": "నేను కూడా అలాగే అనుకుంటున్నాను.",
      "gloss": "I think so too.",
      "words": [
        { "te": "నేను", "gloss": "I" },
        { "te": "కూడా", "gloss": "also" },
        { "te": "అలాగే", "gloss": "that same way" },
        { "te": "అనుకుంటున్నాను", "gloss": "am thinking" }
      ],
      "tags": ["opinions", "agreement"],
      "difficulty": 4,
      "note": "అనుకుంటున్నాను (anukunTunnaanu) = 'I am thinking (so)' — the workhorse verb for opinions. అలాగే (alaagee) = 'like that'."
    },
    {
      "id": "u18-i03",
      "te": "అది నిజమే!",
      "gloss": "That's true!",
      "words": [
        { "te": "అది", "gloss": "that" },
        { "te": "నిజమే", "gloss": "is indeed true" }
      ],
      "tags": ["agreement"],
      "difficulty": 2,
      "distractors": ["u18-i04", "u18-i16"]
    },
    {
      "id": "u18-i04",
      "te": "అది తప్పు అనుకుంటున్నాను.",
      "gloss": "I think that's wrong.",
      "words": [
        { "te": "అది", "gloss": "that" },
        { "te": "తప్పు", "gloss": "wrong / a mistake" },
        { "te": "అనుకుంటున్నాను", "gloss": "am thinking" }
      ],
      "tags": ["opinions", "disagreement"],
      "difficulty": 4,
      "distractors": ["u18-i03", "u18-i05"]
    },
    {
      "id": "u18-i05",
      "te": "మీరు చెప్పింది నిజం.",
      "gloss": "You're right. (what you said is true)",
      "words": [
        { "te": "మీరు", "gloss": "you (polite)" },
        { "te": "చెప్పింది", "gloss": "the thing (you) said" },
        { "te": "నిజం", "gloss": "true" }
      ],
      "tags": ["agreement"],
      "difficulty": 3,
      "distractors": ["u18-i04", "u18-i16"]
    },
    {
      "id": "u18-i06",
      "te": "ఏమో, నాకు తెలియదు.",
      "gloss": "Dunno — I don't know.",
      "words": [
        { "te": "ఏమో", "gloss": "who knows / maybe" },
        { "te": "నాకు", "gloss": "to me" },
        { "te": "తెలియదు", "gloss": "is not known" }
      ],
      "tags": ["opinions", "uncertainty"],
      "difficulty": 2,
      "note": "ఏమో (eemoo) is the universal Telugu shrug — 'maybe, who knows'. It can even be a full answer on its own.",
      "distractors": ["u18-i08", "u18-i13"]
    },
    {
      "id": "u18-i07",
      "te": "ఖచ్చితంగా వస్తాను!",
      "gloss": "I'll definitely come!",
      "words": [
        { "te": "ఖచ్చితంగా", "gloss": "definitely" },
        { "te": "వస్తాను", "gloss": "will come (I)" }
      ],
      "tags": ["certainty"],
      "difficulty": 3,
      "distractors": ["u18-i08", "u18-i11"]
    },
    {
      "id": "u18-i08",
      "te": "ఖచ్చితంగా చెప్పలేను.",
      "gloss": "I can't say for certain.",
      "words": [
        { "te": "ఖచ్చితంగా", "gloss": "for certain" },
        { "te": "చెప్పలేను", "gloss": "cannot say (I)" }
      ],
      "tags": ["uncertainty"],
      "difficulty": 4,
      "note": "-లేను (-leenu) = 'can't': చెప్పలేను (cheppaleenu) I can't say, రాలేను I can't come.",
      "distractors": ["u18-i07", "u18-i06"]
    },
    {
      "id": "u18-i09",
      "te": "నాకు అలా అనిపించడం లేదు.",
      "gloss": "It doesn't feel that way to me.",
      "words": [
        { "te": "నాకు", "gloss": "to me" },
        { "te": "అలా", "gloss": "that way" },
        { "te": "అనిపించడం", "gloss": "seeming / feeling" },
        { "te": "లేదు", "gloss": "is not" }
      ],
      "tags": ["opinions", "disagreement"],
      "difficulty": 4,
      "note": "Feelings use the dative in Telugu: నాకు అనిపిస్తుంది (naaku anipistundi) = 'it seems to me'. This is the polite way to disagree."
    },
