    {
      "id": "u49-i10",
      "te": "నక్కో అంటే నక్కో.",
      "gloss": "No means no.",
      "words": [
        { "te": "నక్కో", "gloss": "no (Hyderabadi)" },
        { "te": "అంటే", "gloss": "means" },
