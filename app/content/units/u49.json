        { "te": "అరేయ్", "gloss": "hey! (drawn out)" },
        { "te": "ఎక్కడున్నావ్", "gloss": "where are you" },
        { "te": "రా", "gloss": "ra (casual particle)" }
      ],
      "tags": ["flavor", "questions"],
      "difficulty": 3,
      "distractors": ["u49-i04", "u49-i12"]
    },
    {
      "id": "u49-i06",
      "te": "ఏంది రా ఇది?",
      "gloss": "What is this, ra?",
      "words": [
        { "te": "ఏంది", "gloss": "what (Telangana)" },
        { "te": "రా", "gloss": "ra (casual particle)" },
        { "te": "ఇది", "gloss": "this" }
      ],
      "tags": ["flavor", "questions"],
      "difficulty": 2,
      "note": "ఏంది is the Telangana/Hyderabad 'what' — standard Telugu says ఏంటి or ఏమిటి. ఏంది రా can be surprise, complaint, or affection depending on tone."
    },
    {
      "id": "u49-i07",
      "te": "ఏం హల్చల్ భయ్?",
      "gloss": "What's happening, bhai?",
      "words": [
        { "te": "ఏం", "gloss": "what" },
        { "te": "హల్చల్", "gloss": "happenings / buzz (Urdu)" },
        { "te": "భయ్", "gloss": "bhai (brother)" }
