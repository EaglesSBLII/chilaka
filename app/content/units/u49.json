    {
      "id": "u49-i13",
      "te": "మా భాష వేరే లెవెల్.",
      "gloss": "Our language is another level.",
      "words": [
        { "te": "మా", "gloss": "our" },
        { "te": "భాష", "gloss": "language" },
        { "te": "వేరే", "gloss": "different / another" },
