  ],
  "dialogue": {
    "id": "u20-d1",
    "title": "Lost in the lanes",
    "scene": "The lanes near Charminar have swallowed you whole. You show your cousin's address to a kind stranger at a tea stall, who swears everything is ten minutes away — and your cousin talks you through the last few turns by phone.",
