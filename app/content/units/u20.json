      { "speaker": "Stranger", "itemId": "u20-i05" },
      { "speaker": "Cousin", "itemId": "u20-i02" },
      { "speaker": "Cousin", "itemId": "u20-i03" },
      { "speaker": "Cousin", "itemId": "u20-i12" },
      { "speaker": "Cousin", "itemId": "u20-i11" },
      { "speaker": "You", "itemId": "u20-i01", "userTurn": true }
    ]
  }
