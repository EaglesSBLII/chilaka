  "dialogue": {
    "id": "u44-d1",
    "title": "Monday at the office",
    "scene": "A buzzing Hyderabad office on Monday morning. Your colleague Ravi wants the meeting time, the boss wants a file and a client update, and you need tomorrow off for a family function.",
    "turns": [
      { "speaker": "Ravi", "itemId": "u44-i01" },
      { "speaker": "You", "itemId": "u44-i02", "userTurn": true },
      { "speaker": "Boss", "itemId": "u44-i12" },
      { "speaker": "Boss", "itemId": "u44-i13" },
      { "speaker": "You", "itemId": "u44-i14", "userTurn": true },
      { "speaker": "Boss", "itemId": "u44-i15" },
      { "speaker": "You", "itemId": "u44-i05", "userTurn": true },
      { "speaker": "Ravi", "itemId": "u44-i03" },
      { "speaker": "You", "itemId": "u44-i04", "userTurn": true },
      { "speaker": "You", "itemId": "u44-i07", "userTurn": true },
      { "speaker": "Boss", "itemId": "u44-i08" },
      { "speaker": "You", "itemId": "u44-i09", "userTurn": true },
      { "speaker": "Boss", "itemId": "u44-i10" },
      { "speaker": "Ravi", "itemId": "u44-i11" }
    ]
  }
