  "description": "Greet people warmly, ask how they are, and answer naturally.",
  "items": [
    {
      "id": "u01-i01",
      "te": "మీరు ఎలా ఉన్నారు?",
      "gloss": "How are you? (polite)",
      "words": [
        {
          "te": "మీరు",
          "gloss": "you (polite)"
        },
        {
          "te": "ఎలా",
          "gloss": "how"
        },
        {
          "te": "ఉన్నారు",
          "gloss": "are (you)"
        }
      ],
      "tags": [
        "greetings",
        "questions"
      ],
      "difficulty": 1,
      "note": "Use మీరు (meeru) with elders and strangers. With friends your own age you can use నువ్వు (nuvvu)."
    },
    {
      "id": "u01-i02",
      "te": "నేను బాగున్నాను.",
      "gloss": "I am fine.",
      "words": [
        {
          "te": "నేను",
          "gloss": "I"
        },
        {
          "te": "బాగున్నాను",
          "gloss": "am fine"
        }
      ],
      "tags": [
        "greetings"
      ],
      "difficulty": 1,
      "distractors": [
        "u01-i01",
        "u01-i04"
