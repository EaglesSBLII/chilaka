      "id": "u01-i12",
      "te": "పెద్దగా ఏమీ లేవు.",
      "gloss": "Nothing much.",
      "words": [
        {
          "te": "పెద్దగా",
          "gloss": "much / big-ly"
        },
        {
          "te": "ఏమీ",
          "gloss": "anything"
        },
        {
          "te": "లేవు",
