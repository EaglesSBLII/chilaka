    {
      "id": "u01-i13",
      "te": "రండి, కూర్చోండి.",
      "gloss": "Come, sit down. (polite)",
      "words": [
        {
          "te": "రండి",
          "gloss": "come (polite)"
        },
        {
          "te": "కూర్చోండి",
          "gloss": "sit (polite)"
        }
      ],
      "tags": [
        "hospitality",
        "commands"
      ],
      "difficulty": 1,
      "note": "The -ండి (-nDi) ending makes a command polite: రా → రండి, కూర్చో → కూర్చోండి."
    },
    {
      "id": "u01-i14",
      "te": "భోజనం చేశారా?",
      "gloss": "Have you eaten? (a caring greeting)",
      "words": [
        {
          "te": "భోజనం",
          "gloss": "meal"
        },
        {
          "te": "చేశారా",
          "gloss": "did (you) do?"
        }
      ],
      "tags": [
        "hospitality",
        "questions"
      ],
      "difficulty": 2,
      "note": "Asking if someone ate is a warm greeting in Telugu culture, not literal curiosity."
    },
    {
      "id": "u01-i15",
      "te": "వెళ్ళొస్తాను.",
      "gloss": "I'll take leave. (lit: I'll go and come)",
      "words": [
        {
          "te": "వెళ్ళొస్తాను",
          "gloss": "I'll go and come back"
        }
      ],
      "tags": [
        "greetings"
      ],
      "difficulty": 2,
      "note": "Telugu never says a flat goodbye — వెళ్ళొస్తాను ('I'll go and come') keeps the door open."
    },
    {
      "id": "u01-i16",
      "te": "మళ్ళీ కలుద్దాం.",
