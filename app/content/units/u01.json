    },
    {
      "id": "u01-i03",
      "te": "మీరు బాగున్నారా?",
      "gloss": "Are you doing well?",
      "words": [
        {
          "te": "మీరు",
          "gloss": "you (polite)"
        },
        {
          "te": "బాగున్నారా",
          "gloss": "are (you) well?"
        }
      ],
      "tags": [
        "greetings",
        "questions"
      ],
      "difficulty": 1,
      "note": "The -ఆ (-aa) ending turns a statement into a yes/no question: బాగున్నారు → బాగున్నారా?"
    },
    {
      "id": "u01-i04",
      "te": "నేను కూడా బాగున్నాను.",
      "gloss": "I am also fine.",
      "words": [
        {
          "te": "నేను",
          "gloss": "I"
        },
        {
          "te": "కూడా",
          "gloss": "also"
        },
        {
          "te": "బాగున్నాను",
          "gloss": "am fine"
        }
      ],
      "tags": [
        "greetings"
      ],
      "difficulty": 1
    },
    {
      "id": "u01-i05",
      "te": "మీ పేరు ఏంటి?",
      "gloss": "What is your name?",
