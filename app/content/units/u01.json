      "difficulty": 2
    },
    {
      "id": "u01-i09",
      "te": "ఇంట్లో అందరూ బాగున్నారా?",
      "gloss": "Is everyone at home doing well?",
      "words": [
        {
          "te": "ఇంట్లో",
          "gloss": "at home"
        },
        {
          "te": "అందరూ",
          "gloss": "everyone"
        },
        {
          "te": "బాగున్నారా",
          "gloss": "are (they) well?"
        }
      ],
      "tags": [
        "family",
        "questions"
      ],
      "difficulty": 2,
      "note": "This is THE classic caring question in Telugu families — ask it on every call."
