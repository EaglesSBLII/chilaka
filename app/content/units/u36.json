        { "te": "సొంత", "gloss": "own" },
        { "te": "ఇల్లు", "gloss": "house" },
        { "te": "కట్టుకోవాలని", "gloss": "wanting to build" },
        { "te": "ఉంది", "gloss": "there is" }
