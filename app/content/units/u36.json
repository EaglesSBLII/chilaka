    {
      "id": "u36-i08",
      "te": "ఇది అయితే చాలా బాగుంటుంది.",
      "gloss": "If this works out, it'll be great.",
      "words": [
        { "te": "ఇది", "gloss": "this" },
        { "te": "అయితే", "gloss": "if it happens" },
        { "te": "చాలా", "gloss": "very" },
        { "te": "బాగుంటుంది", "gloss": "will be good" }
      ],
      "tags": ["hope", "conditional"],
      "difficulty": 2,
      "note": "అయితే after a noun means 'if it comes through': ఇది అయితే... — the standard hedge for plans not yet certain.",
      "distractors": ["u36-i04", "u36-i13"]
    },
    {
      "id": "u36-i09",
      "te": "మీ కల ఏంటి?",
