  "dialogue": {
    "id": "u38-d1",
    "title": "The birthday party squabble",
    "scene": "You and your cousin Suresh are planning grandma's 75th birthday — and disagree about the venue. Voices rise a little, then hearts soften, and it ends the only proper way: over coffee.",
    "turns": [
      { "speaker": "Suresh", "itemId": "u38-i01" },
      { "speaker": "You", "itemId": "u38-i02", "userTurn": true },
      { "speaker": "You", "itemId": "u38-i09", "userTurn": true },
