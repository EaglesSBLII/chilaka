      "id": "u15-i16",
      "te": "సాయంత్రం త్వరగా వస్తాను.",
      "gloss": "I'll come home early this evening.",
      "words": [
        { "te": "సాయంత్రం", "gloss": "evening" },
        { "te": "త్వరగా", "gloss": "early / quickly" },
