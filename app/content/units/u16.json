        { "te": "ఇండియా", "gloss": "India" },
        { "te": "వెళ్తాం", "gloss": "we will go" }
      ],
      "tags": ["future", "plans", "travel"],
      "difficulty": 3,
      "note": "వచ్చే (vachchee) 'coming' = next: వచ్చే వారం next week, వచ్చే నెల next month, వచ్చే ఏడాది next year."
    },
    {
