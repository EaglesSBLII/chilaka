    {
      "id": "u03-i13",
      "te": "ఏం వండుతున్నారు?",
      "gloss": "What are you cooking?",
      "words": [
        { "te": "ఏం", "gloss": "what" },
        { "te": "వండుతున్నారు", "gloss": "are (you) cooking (polite)" }
