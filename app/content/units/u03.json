      "tags": ["actions", "family"],
      "difficulty": 2
    },
    {
      "id": "u03-i11",
      "te": "నేను ఆఫీసులో పని చేస్తున్నాను.",
      "gloss": "I am working at the office.",
      "words": [
        { "te": "నేను", "gloss": "I" },
        { "te": "ఆఫీసులో", "gloss": "at the office" },
        { "te": "పని", "gloss": "work" },
        { "te": "చేస్తున్నాను", "gloss": "am doing" }
      ],
      "tags": ["actions", "work"],
      "difficulty": 2
    },
    {
      "id": "u03-i12",
      "te": "వర్షం పడుతోంది.",
      "gloss": "It is raining.",
      "words": [
        { "te": "వర్షం", "gloss": "rain" },
        { "te": "పడుతోంది", "gloss": "is falling" }
      ],
      "tags": ["weather"],
      "difficulty": 1,
      "note": "Rain 'falls' in Telugu: వర్షం పడుతోంది, literally 'rain is falling'."
