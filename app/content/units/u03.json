    {
      "id": "u03-i14",
      "te": "కూర వండుతున్నాను.",
      "gloss": "I'm cooking curry.",
      "words": [
        { "te": "కూర", "gloss": "curry / vegetable dish" },
        { "te": "వండుతున్నాను", "gloss": "am cooking" }
