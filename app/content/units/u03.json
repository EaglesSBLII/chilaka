  "description": "Say what you and everyone around you are doing right now.",
  "items": [
    {
      "id": "u03-i01",
      "te": "ఏం చేస్తున్నారు?",
      "gloss": "What are you doing? (polite)",
      "words": [
        { "te": "ఏం", "gloss": "what" },
        { "te": "చేస్తున్నారు", "gloss": "are (you) doing (polite)" }
      ],
      "tags": ["actions", "questions"],
      "difficulty": 1,
      "note": "With friends and younger family: ఏం చేస్తున్నావ్? (eem cheestunnaav) — the final vowel drops in speech."
    },
    {
      "id": "u03-i02",
      "te": "నేను వంట చేస్తున్నాను.",
      "gloss": "I am cooking.",
      "words": [
        { "te": "నేను", "gloss": "I" },
        { "te": "వంట", "gloss": "cooking (noun)" },
        { "te": "చేస్తున్నాను", "gloss": "am doing" }
      ],
      "tags": ["actions", "food"],
      "difficulty": 1,
      "distractors": ["u03-i03", "u03-i14"]
    },
    {
      "id": "u03-i03",
      "te": "అమ్మ వంట చేస్తోంది.",
      "gloss": "Mom is cooking.",
      "words": [
        { "te": "అమ్మ", "gloss": "mom" },
        { "te": "వంట", "gloss": "cooking (noun)" },
        { "te": "చేస్తోంది", "gloss": "she is doing" }
      ],
      "tags": ["actions", "family", "food"],
      "difficulty": 1,
      "note": "-తోంది (-toondi) is the natural spoken 'she/it is doing': చేస్తోంది, వస్తోంది. The textbook form చేస్తున్నది sounds stiff.",
      "distractors": ["u03-i02", "u03-i12"]
    },
    {
      "id": "u03-i04",
      "te": "నాన్న టీవీ చూస్తున్నారు.",
      "gloss": "Dad is watching TV.",
      "words": [
        { "te": "నాన్న", "gloss": "dad" },
        { "te": "టీవీ", "gloss": "TV" },
        { "te": "చూస్తున్నారు", "gloss": "is watching (respectful)" }
      ],
      "tags": ["actions", "family"],
      "difficulty": 1,
      "distractors": ["u03-i03", "u03-i15"]
    },
    {
      "id": "u03-i05",
      "te": "నేను అన్నం తింటున్నాను.",
      "gloss": "I am eating rice.",
      "words": [
        { "te": "నేను", "gloss": "I" },
        { "te": "అన్నం", "gloss": "rice / food" },
        { "te": "తింటున్నాను", "gloss": "am eating" }
      ],
      "tags": ["actions", "food"],
      "difficulty": 1,
      "note": "అన్నం (annam) is cooked rice — and by extension 'food'. అన్నం తిన్నావా? is how family asks 'have you eaten?'",
      "distractors": ["u03-i02", "u03-i15"]
    },
    {
      "id": "u03-i06",
      "te": "తమ్ముడు ఆడుతున్నాడు.",
      "gloss": "Little brother is playing.",
      "words": [
        { "te": "తమ్ముడు", "gloss": "younger brother" },
        { "te": "ఆడుతున్నాడు", "gloss": "he is playing" }
      ],
      "tags": ["actions", "family"],
      "difficulty": 1
    },
    {
      "id": "u03-i07",
      "te": "ఎక్కడికి వెళ్తున్నారు?",
