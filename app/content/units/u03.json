      "words": [
        { "te": "ఎక్కడికి", "gloss": "to where" },
        { "te": "వెళ్తున్నారు", "gloss": "are (you) going (polite)" }
      ],
      "tags": ["actions", "questions"],
      "difficulty": 1
    },
    {
      "id": "u03-i08",
      "te": "నేను ఇంటికి వెళ్తున్నాను.",
      "gloss": "I am going home.",
      "words": [
        { "te": "నేను", "gloss": "I" },
        { "te": "ఇంటికి", "gloss": "to home" },
        { "te": "వెళ్తున్నాను", "gloss": "am going" }
      ],
      "tags": ["actions"],
      "difficulty": 1,
      "distractors": ["u03-i09", "u03-i07"]
    },
    {
      "id": "u03-i09",
      "te": "ఇప్పుడే వస్తున్నాను.",
      "gloss": "I'm coming right now.",
      "words": [
        { "te": "ఇప్పుడే", "gloss": "right now" },
        { "te": "వస్తున్నాను", "gloss": "am coming" }
      ],
      "tags": ["actions"],
      "difficulty": 1,
      "note": "ఇప్పుడు (ippuDu) = now; the -ే adds 'just/right': ఇప్పుడే = right now. In speech వస్తున్నాను often shortens to వస్తున్నా.",
      "distractors": ["u03-i08", "u03-i07"]
    },
    {
      "id": "u03-i10",
      "te": "చెల్లి చదువుకుంటోంది.",
      "gloss": "Little sister is studying.",
      "words": [
        { "te": "చెల్లి", "gloss": "younger sister" },
        { "te": "చదువుకుంటోంది", "gloss": "she is studying" }
